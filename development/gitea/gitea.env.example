# Non-secret settings only. SECRET_KEY and INTERNAL_TOKEN are fetched live from
# Vault (homelab/services/gitea), the database password from
# homelab/databases/postgres (key gitea_password) -- see the entrypoint in
# docker-compose.yaml.

# Public URL
TRAEFIK_HOST=git.example.com

# Database
DB_TYPE=postgres
DB_HOST=postgres
DB_NAME=gitea
DB_USER=gitea

# SMTP (optional, for e-mail notifications; uncomment the mailer block in docker-compose.yaml)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=gitea@example.com
# SMTP_USERNAME=
