# /opt/docker/secrets/secrets.yaml -- included by every compose file:
#
#   include:
#     - /opt/docker/secrets/secrets.yaml
#
# One role_id/secret_id pair per service (see HOWTO.md, step 4). The files are root-only
# (mode 600) and never part of the repository.
secrets:
  vaultwarden_vault_role_id:
    file: /opt/docker/secrets/vaultwarden_vault_role_id.txt
  vaultwarden_vault_secret_id:
    file: /opt/docker/secrets/vaultwarden_vault_secret_id.txt

  mariadb_vault_role_id:
    file: /opt/docker/secrets/mariadb_vault_role_id.txt
  mariadb_vault_secret_id:
    file: /opt/docker/secrets/mariadb_vault_secret_id.txt
