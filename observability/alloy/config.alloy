// ========================== 
// 1) DOCKER LOGS 
// ========================== 
discovery.docker "containers" { 
  host             = "tcp://docker-socket-proxy:2375" 
  refresh_interval = "5s" 
} 
 
discovery.relabel "docker_logs" { 
  targets = discovery.docker.containers.targets 
 
  rule { 
    target_label = "job" 
    replacement  = "docker" 
  } 
 
  rule { 
    target_label = "host" 
    replacement  = constants.hostname 
  } 
 
  rule { 
    action        = "replace" 
    source_labels = ["__meta_docker_container_name"] 
    regex         = "^/(.*)" 
    replacement   = "$1" 
    target_label  = "container" 
  } 
 
  rule { 
    action        = "replace" 
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"] 
    target_label  = "service" 
  } 
 
  rule { 
    action        = "replace" 
    source_labels = ["__meta_docker_container_image"] 
    target_label  = "image" 
  } 
 
  rule { 
    action        = "replace" 
    source_labels = ["__meta_docker_container_log_stream"] 
    target_label  = "stream" 
  } 
} 
 
loki.source.docker "docker" { 
  host       = "tcp://docker-socket-proxy:2375" 
  targets    = discovery.relabel.docker_logs.output 
  forward_to = [loki.write.default.receiver] 
} 

// ========================== 
// 2) SYSTEMD JOURNAL (SSH, SUDO, all system logs)
// ========================== 
loki.source.journal "journal" {
  format_as_json = true
  forward_to = [loki.process.journal.receiver]
}

loki.process "journal" {
  // Extract important fields
  stage.json {
    expressions = {
      message   = "MESSAGE",
      unit      = "_SYSTEMD_UNIT",
      priority  = "_PRIORITY",
      hostname  = "_HOSTNAME",
      ident     = "SYSLOG_IDENTIFIER",
    }
  }

  // stage.labels maps label -> name of an extracted field (not a literal value);
  // "job = systemd" / "host = constants.hostname" used to produce empty labels.
  // host now comes from the journal's _HOSTNAME (the real host, not the container);
  // job keeps the automatic value loki.source.journal.journal, which existing alert
  // rules (SSH-Login) match on.
  stage.labels {
    values = {
      host     = "hostname",
      unit     = "unit",
      priority = "priority",
      // e.g. homelab-deploy (logger -t) for the deploy alert (#100 STEP 9)
      syslog_identifier = "ident",
    }
  }

  stage.output {
    source = "message"
  }

  forward_to = [loki.write.default.receiver]
}

// ========================== 
// 3) BACKUP LOGFILES 
// ========================== 
