# Non-secret settings only. AUTHENTIK_SECRET_KEY, the Postgres password and the
# mail username/password are fetched from Vault at container start (see the
# entrypoint in docker-compose.yaml) -- do not put them here.
TRAEFIK_HOST=auth.example.com
ERROR_REPORTING_ENABLED=false
POSTGRES_HOST=postgres
POSTGRES_DB=authentik
POSTGRES_USER=authentik
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
EMAIL_FROM=authentik@example.com
