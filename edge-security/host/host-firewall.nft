#!/usr/sbin/nft -f
# Host firewall for services listening directly on the host (INPUT).
#
# Docker ports (80/443, DNS, MQTT, Gitea SSH ...) go through FORWARD via DNAT
# and are NOT affected by this. Docker's and CrowdSec's rules live in their
# own tables and stay untouched -- hence NO "flush ruleset", only this one
# table is reloaded.
#
# Installed to /etc/homelab-firewall/host-firewall.nft by host-firewall.sh

table inet host-firewall
delete table inet host-firewall

table inet host-firewall {
	set admin_v4 {
		type ipv4_addr
		flags interval
		elements = {
			203.0.113.0/24,	# VPN
			192.0.2.0/24	# LAN
		}
	}

	set vpn_v4 {
		type ipv4_addr
		flags interval
		elements = { 203.0.113.0/24 }
	}

	chain input {
		type filter hook input priority filter + 10; policy drop;

		iif "lo" accept
		ct state established,related accept
		ct state invalid drop

		meta l4proto icmp accept
		meta l4proto ipv6-icmp accept

		# DHCP replies (eno1 gets its address via DHCP)
		udp sport 67 udp dport 68 accept

		# Container -> host (e.g. Traefik bouncer -> CrowdSec LAPI :8080)
		ip saddr 172.16.0.0/12 accept

		tcp dport 22 ip saddr @admin_v4 accept
		tcp dport 3389 ip saddr @vpn_v4 accept

		limit rate 10/minute burst 20 packets log prefix "host-fw drop: " level info
	}
}
